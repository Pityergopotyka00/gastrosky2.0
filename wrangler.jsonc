{
  "name": "gastrosky2-0",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-11-13",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  // Replace the placeholder UUID with the Cloudflare D1 database ID before deploying.
  // The admin endpoints remain unavailable until the actual binding and secret exist.
  "d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "gastrosky-admin",
      "database_id": "2057d8f7-1e72-4314-8939-dfce413bee7a",
      "migrations_dir": "migrations"
    }
  ],
  // Never add ADMIN_TOTP_KEY, ADMIN_SETUP_PASSWORD or authenticator
  // enrollment secrets to vars or GitHub. Set ADMIN_TOTP_KEY using
  // Cloudflare Worker Secrets; setup email/password/role are prompted locally.
  "vars": {
    "QUOTE_TO_EMAIL": "info@gastrosky.hu"
  },
  "ratelimits": [
    {
      "name": "CATALOG_RATE_LIMITER",
      "namespace_id": "62014",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "QUOTE_RATE_LIMITER",
      "namespace_id": "62015",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "ADMIN_AUTH_RATE_LIMITER",
      "namespace_id": "62016",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
