{
  // On-demand supplier page verification only. No scheduled bulk crawling.
  // Unknown or inaccessible supplier inventory is never reported as available.
  "name": "gastrosky2-0",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-11-13",
  "vars": {
    "ENABLE_SITE_CHECKS": "true"
  }
}
