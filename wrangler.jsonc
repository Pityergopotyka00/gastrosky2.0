{
  "name": "gastrosky2-stock-preview",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-13",
  "triggers": { "crons": [ "*/5 * * * *" ] },
  "vars": {
    "ENABLE_STOCK_SYNC": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gastrosky2-stock",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID"
    }
  ]
}
